# macOS
.DS_Store

# Local scratch space used by some agent workflows. Not a shared artefact.
.scratch/

# Build trees.  check.sh builds into build/ by default and CMake writes
# compile_commands.json there for clangd and the agents that read it.
build/
build-*/

# Hardware reports. measure-hardware.sh writes one into the directory it is run
# from, and the runbook has you run it from the repository root, so it would
# otherwise sit there as an untracked file after every session.
hardware-report-*.txt
